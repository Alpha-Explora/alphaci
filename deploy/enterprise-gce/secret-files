# Secret files in /opt/alphaci/secrets/ that every deploy writes, one per line.
# Each comes from the GitHub secret of the same name in upper case in the
# enterprise-gce environment: database_url from DATABASE_URL, and github_x
# from GH_X because GitHub reserves the GITHUB_ prefix. compose.yaml
# mounts them at /run/secrets/<name>. Files not listed here, such as the host
# agent's machine-token, are left alone.

database_url
session_secret
github_oauth_client_secret
github_app_private_key
github_app_webhook_secret
release_signing_key
env_provisioning_encryption_key
onprem_registry_token
sonar_token
