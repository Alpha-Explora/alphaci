# alphaci.env for the enterprise Compute Engine VM. Every deploy renders
# /opt/alphaci/alphaci.env from this file; edits made on the VM are replaced.
#
#   KEY=value   fixed here, the same for every install of this kind
#   KEY         the GitHub variable KEY in the enterprise-gce environment (required)
#   KEY?        the same, or an empty value when the variable is not set
#
# GitHub reserves names that start with GITHUB_, so GITHUB_X is the variable
# GH_X in the environment.
#
# To add a setting, add its line here and, for KEY or KEY?, create the
# variable in the environment. Secret values never go here: they are files
# listed in secret-files. See docs/runbooks/runbook-enterprise-gce-deploy.md.

ALPHACI_HOSTNAME
ALPHACI_TLS_DIRECTIVE?
PLATFORM_PUBLIC_URL
FRONTEND_URL
ALLOWED_ORIGINS
GITHUB_CALLBACK_URL
NODE_ENV=production
PORT=4000
ALPHACI_EDITION=enterprise
ALPHACI_BUILD_PROFILE=enterprise
ALPHACI_DEPLOYMENT_MODE=selfhosted
SUBSCRIPTION_GATE_ENABLED
ENABLE_SWAGGER
TRUST_PROXY_HOPS=1
SESSION_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_STORE_DRIVER=postgres
STORAGE_DRIVER=postgres
OUTBOX_RELAY_INTERVAL_MS
ALPHACI_RELEASE_SIGNER=file
ALPHACI_RELEASE_SIGNING_KEY_FILE=/run/secrets/release_signing_key
GITHUB_CLIENT_ID
GITHUB_APP_ID
GITHUB_APP_SLUG
GITHUB_ENFORCED_ORG
MEMBER_DIRECTORY_SOURCE
HIERARCHY_GITHUB_SYNC_MODE
DATABASE_URL_FILE=/run/secrets/database_url
SESSION_SECRET_FILE=/run/secrets/session_secret
ENV_PROVISIONING_ENCRYPTION_KEY_FILE=/run/secrets/env_provisioning_encryption_key
GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_oauth_client_secret
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
DEV_QUICK_LOGIN
ENV_PROVISIONING_ENABLED
ONPREM_RELEASES_ENABLED
ONPREM_INSTALLER_URL
ONPREM_INSTALLER_VERSION
ONPREM_INSTALLER_SHA256
ONPREM_INSTALLER_PATH=/app/assets/alphaci-agent.tar.gz
SUPABASE_DB_CA_CERT
GITHUB_INTERNAL_ORG
GITHUB_SCOPE
ENV_PROVISIONING_OWNERSHIP_MODE
CI_RUN_LIVE_GITHUB_ENABLED
AUDIT_EVENTS_ENABLED
NOTIFICATIONS_ENABLED
QA_CHECKLISTS_ENABLED
WORKFLOW_SETTINGS_PREVIEW_ENABLED
WORKFLOW_UPDATE_PR_ENABLED
WORKSPACES_ENABLED
CI_RUN_TRACKING_ENABLED
PROJECT_TARGET_MANAGEMENT_ENABLED
GITHUB_APP_WEBHOOK_SECRET_FILE=/run/secrets/github_app_webhook_secret
ONPREM_APPS_DOMAIN
ONPREM_REGISTRY_TOKEN_FILE=/run/secrets/onprem_registry_token
ONPREM_REGISTRY_USERNAME
ONPREM_REGISTRY_SERVER=ghcr.io
ALPHACI_SONAR_ORGANIZATION
ALPHACI_SONAR_TOKEN_FILE=/run/secrets/sonar_token
