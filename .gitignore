# Root of the monorepo. Each app keeps its own .gitignore for app-specific paths.
node_modules/
.turbo/
*.tsbuildinfo
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
!**/deploy/**/*.env
!**/deploy/**/.env.example

# Self-hosted appliance: generated secrets and per-install settings.
/deploy/selfhost/alphaci.env
/deploy/selfhost/.env
/deploy/selfhost/secrets/
/deploy/selfhost/certs/

# Screenshot galleries never go in the repository; share them outside git.
/docs/plans/**/screenshots/
/docs/plans/**/*.zip
