{
  "name": "@alphaci/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:saas": "node scripts/run-edition.mjs saas next dev --turbopack",
    "dev:edu": "node scripts/run-edition.mjs edu next dev --turbopack",
    "dev:enterprise": "node scripts/run-edition.mjs enterprise next dev --turbopack",
    "build": "next build --webpack",
    "build:saas": "node scripts/run-edition.mjs saas next build --webpack",
    "build:edu": "node scripts/run-edition.mjs edu next build --webpack",
    "build:enterprise": "node scripts/run-edition.mjs enterprise next build --webpack",
    "start": "next start",
    "lint": "oxlint --report-unused-disable-directives --max-warnings=0 src && eslint --concurrency=4 src --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "node ../../node_modules/typescript-7/bin/tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:fullstack": "tsx tests/fullstack/run.ts",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=715",
    "complexity": "node scripts/check-complexity.cjs",
    "arch:check": "node scripts/check-boundaries.mjs --cwd . --src auto",
    "arch:check:touched": "node scripts/check-boundaries.mjs --cwd . --src auto --since origin/main",
    "arch:new": "node \"${NFA:-$HOME/.agents/skills/next-feature-architecture}/scripts/scaffold-feature.mjs\"",
    "check:capabilities": "node scripts/check-capabilities.cjs",
    "check:profiles": "node scripts/check-build-profiles.cjs",
    "build:profile": "node scripts/build-profile.cjs",
    "generate:architecture-maps": "node scripts/generate-architecture-maps.mjs",
    "check:documentation": "node scripts/check-documentation.cjs",
    "check:profile-build:hosted": "node scripts/build-profile.cjs --profile hosted",
    "check:profile-build:enterprise": "node scripts/build-profile.cjs --profile enterprise"
  },
  "dependencies": {
    "@alphaci/api-contracts": "*",
    "@alphaci/capability-catalog": "*",
    "driver.js": "^1.4.0",
    "framer-motion": "^14.9.1",
    "next": "^16.4.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@alphaci/config": "*",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-oxlint": "^1.90.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
