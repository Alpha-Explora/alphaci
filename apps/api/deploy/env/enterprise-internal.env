# Alpha Explora's own hosted deployment: the API on Render, the web app on
# Vercel, used by the company's internal teams.
#
# The declared client policy lives in src/packs/enterprise/clients. Set these
# on the Render web service AND on the outbox cron job, which reads the same
# policy. The web app needs no client value: it learns the result from
# /api/v1/capabilities.
#
# Hosted on Render with Supabase, so ALPHACI_DEPLOYMENT_MODE stays unset
# (saas). Secrets and URLs are not presets; set them on the service.
ALPHACI_BUILD_PROFILE=enterprise
ALPHACI_EDITION=enterprise
ALPHACI_CLIENT=alphaexplora-internal
ALPHACI_CLIENT_CONFIG=

# Repositories are created in, and sign-in is limited to, the company org.
GITHUB_ENFORCED_ORG=Alpha-Explora
GITHUB_INTERNAL_ORG=Alpha-Explora

# Roles come from the org's GitHub teams on every login. The org has no QA
# team; Product owners verify and sign off QA runs themselves.
GITHUB_TEAM_ROLE_SYNC=enforce
GITHUB_TEAM_LEAD_SLUG=team-lead
GITHUB_TEAM_DEVELOPER_SLUG=developers
