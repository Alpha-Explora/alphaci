{
  // Lint rules for apps/api, run first by `npm run lint` (oxlint, then eslint).
  // This is the rule set eslint.config.mjs enforced before (eslint:recommended,
  // typescript-eslint recommended-type-checked, the explicit rules there), one
  // for one, type-aware rules included: tsgolint (TypeScript 7) supplies types.
  // eslint.config.mjs turns off every rule Oxlint runs (eslint-plugin-oxlint)
  // and keeps only what Oxlint lacks:
  //   prettier/prettier                     no formatter check in Oxlint
  //   @typescript-eslint/consistent-type-imports
  //                                         Oxlint's rule ignores decorator
  //                                         metadata, so it would demand
  //                                         `import type` for Nest DI params
  //   no-octal                              not in Oxlint
  // Categories are off so only the rules below and the shared ones run.
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  // Rules both apps enforce identically: packages/config/oxlint.base.json.
  // eslint-plugin-oxlint follows `extends`, so ESLint turns those off too.
  "extends": ["../../node_modules/@alphaci/config/oxlint.base.json"],
  "plugins": [
    "eslint",
    "typescript"
  ],
  "categories": { "correctness": "off" },
  "options": { "typeAware": true },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true,
    "jest": true
  },
  // `npm run lint` covered *.ts only; scripts and k6 smoke tests are plain JS.
  "ignorePatterns": [
    "**/*.js",
    "**/*.cjs",
    "**/*.mjs"
  ],
  "rules": {
    "eslint/for-direction": "error",
    "eslint/no-async-promise-executor": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-compare-neg-zero": "error",
    "eslint/no-cond-assign": [
      "error",
      "except-parens"
    ],
    "eslint/no-constant-binary-expression": [
      "error",
      {
        "checkRelationalComparisons": false
      }
    ],
    "eslint/no-constant-condition": [
      "error",
      {
        "checkLoops": "allExceptWhileTrue"
      }
    ],
    "eslint/no-control-regex": "error",
    "eslint/no-debugger": "error",
    "eslint/no-delete-var": "error",
    "eslint/no-dupe-else-if": "error",
    "eslint/no-duplicate-case": "error",
    "eslint/no-empty": [
      "error",
      {
        "allowEmptyCatch": false
      }
    ],
    "eslint/no-empty-character-class": "error",
    "eslint/no-empty-pattern": [
      "error",
      {
        "allowObjectPatternsAsParameters": false
      }
    ],
    "eslint/no-empty-static-block": "error",
    "eslint/no-ex-assign": "error",
    "eslint/no-extra-boolean-cast": [
      "error",
      {}
    ],
    "eslint/no-fallthrough": [
      "error",
      {
        "allowEmptyCase": false,
        "reportUnusedFallthroughComment": false
      }
    ],
    "eslint/no-global-assign": [
      "error",
      {
        "exceptions": []
      }
    ],
    "eslint/no-invalid-regexp": [
      "error",
      {}
    ],
    "eslint/no-irregular-whitespace": [
      "error",
      {
        "skipComments": false,
        "skipJSXText": false,
        "skipRegExps": false,
        "skipStrings": true,
        "skipTemplates": false
      }
    ],
    "eslint/no-loss-of-precision": "error",
    "eslint/no-misleading-character-class": [
      "error",
      {
        "allowEscape": false
      }
    ],
    "eslint/no-nonoctal-decimal-escape": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/no-regex-spaces": "error",
    "eslint/no-self-assign": [
      "error",
      {
        "props": true
      }
    ],
    "eslint/no-shadow-restricted-names": [
      "error",
      {
        "reportGlobalThis": true
      }
    ],
    "eslint/no-sparse-arrays": "error",
    "eslint/no-unassigned-vars": "error",
    "eslint/no-unsafe-finally": "error",
    "eslint/no-unsafe-optional-chaining": [
      "error",
      {
        "disallowArithmeticOperators": false
      }
    ],
    "eslint/no-unused-expressions": [
      "error",
      {
        "allowShortCircuit": false,
        "allowTaggedTemplates": false,
        "allowTernary": false
      }
    ],
    "eslint/no-unused-labels": "error",
    "eslint/no-unused-private-class-members": "error",
    "eslint/no-unused-vars": "error",
    "eslint/no-useless-assignment": "error",
    "eslint/no-useless-backreference": "error",
    "eslint/no-useless-catch": "error",
    "eslint/no-useless-escape": [
      "error",
      {
        "allowRegexCharacters": []
      }
    ],
    "eslint/preserve-caught-error": [
      "error",
      {
        "requireCatchParameter": false
      }
    ],
    "eslint/require-yield": "error",
    "eslint/use-isnan": [
      "error",
      {
        "enforceForIndexOf": false,
        "enforceForSwitchCase": true
      }
    ],
    "eslint/valid-typeof": [
      "error",
      {
        "requireStringLiterals": false
      }
    ],
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/unbound-method": "error"
  },
  "overrides": [
    {
      // Specs mock freely; same relaxations as before.
      "files": ["**/*.spec.ts"],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/no-require-imports": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/require-await": "off",
        "typescript/unbound-method": "off"
      }
    }
  ]
}
