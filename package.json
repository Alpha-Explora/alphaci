{
  "name": "alphaci",
  "private": true,
  "description": "AlphaCI platform monorepo: NestJS API (apps/api) and Next.js web (apps/web).",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev start:dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "boundaries": "turbo run boundaries",
    "check:documentation": "node scripts/check-documentation.cjs && turbo run check:documentation",
    "check:capabilities": "turbo run check:capabilities",
    "check:capability-package": "turbo run check:capability-package",
    "check:versions": "node scripts/check-versions.mjs",
    "check:dependabot": "node scripts/check-dependabot-groups.mjs",
    "check:deps": "knip --include dependencies,unlisted,binaries,unresolved",
    "test:documentation": "node --test scripts/check-okf-bundle.test.cjs"
  },
  "devDependencies": {
    "js-yaml": "^5.5.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.92.0",
    "prettier": "^3.4.2",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true,
    "unrs-resolver": true,
    "@scarf/scarf": false,
    "@nestjs/core": false,
    "lefthook": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
